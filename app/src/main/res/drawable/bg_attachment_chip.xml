<?xml version="1.0" encoding="utf-8"?>
<!--
  bg_attachment_chip.xml — background (rounded + stroke) cho chip attachment
  (alternate khi không muốn dùng MaterialCardView).
  Hiện tại item_attachment.xml dùng MaterialCardView, file này để optional
  fallback (vd dùng trong dialog).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@android:color/white" />
    <stroke
        android:width="1dp"
        android:color="#E0E0E0" />
    <corners android:radius="8dp" />
</shape>
