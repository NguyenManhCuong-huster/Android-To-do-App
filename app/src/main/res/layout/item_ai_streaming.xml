<?xml version="1.0" encoding="utf-8"?>
<!--
  item_ai_streaming.xml — bong bóng assistant ĐANG stream (text cập nhật dần).
  Cùng tông trắng với bubble assistant; con trỏ ▌ báo "đang gõ".
  Rộng theo khung (match_parent + lề phải) + TextView match_parent để Markwon
  render bảng đúng (giống item_ai_message.xml).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="12dp"
    android:paddingVertical="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginEnd="40dp"
        android:background="@android:color/white"
        android:elevation="1dp"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/tvStreaming"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </LinearLayout>

</FrameLayout>
