<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_ai_chat.xml — màn AI chat (Email / News / Standalone).

  ┌──────────────────────────────────┐
  │ ← Trợ lý AI                       │ Header
  │   tvSubtitle (Về email/news/...)  │
  ├──────────────────────────────────┤
  │ [chip] [chip] [chip]              │ Quick prompts
  ├──────────────────────────────────┤
  │ rvMessages                        │
  │  ...bubble user/assistant...      │
  ├──────────────────────────────────┤
  │ [📎file.pdf×] [📎...×]   ⌛       │ pendingAttachmentsRow (GONE)
  ├──────────────────────────────────┤
  │ [📎] [etInput..........]  [Gửi]   │ Footer input
  └──────────────────────────────────┘

  THAY ĐỔI 2026-05-31:
   - Thêm btnAttach (paperclip) bên trái etInput trong footer.
   - Thêm pendingAttachmentsRow (LinearLayout, GONE mặc định) trên footer,
     chứa progress + horizontalScroll các chip file đang chờ gửi kèm.
   - rvMessages giờ constraint bottom_toTopOf pendingAttachmentsRow
     (khi row GONE thì pending row có size 0, rvMessages tự sát footer).
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="32dp"
    android:background="#F5F6F8">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@android:drawable/ic_menu_revert" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Trợ lý AI"
                android:textColor="#222222"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#666666"
                android:textSize="11sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressThinking"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Quick prompt chips -->
    <HorizontalScrollView
        android:id="@+id/chipsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:paddingHorizontal="8dp"
        android:paddingBottom="8dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chipSummarize"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:minHeight="36dp"
                android:paddingHorizontal="12dp"
                android:text="Tóm tắt"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chipReply"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:minHeight="36dp"
                android:paddingHorizontal="12dp"
                android:text="Soạn phản hồi"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chipActions"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:paddingHorizontal="12dp"
                android:text="Action items"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Messages -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toTopOf="@id/pendingAttachmentsRow"
        app:layout_constraintTop_toBottomOf="@id/chipsRow" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Hỏi AI...\n(Tóm tắt / Phản hồi / Action items)"
        android:textColor="#888"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/pendingAttachmentsRow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chipsRow" />

    <!--
      Pending attachments row (GONE mặc định).
      Activity::renderPendingAttachments() set visibility + inflate chip vào
      pendingAttachmentsContainer.
    -->
    <LinearLayout
        android:id="@+id/pendingAttachmentsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/footer">

        <ProgressBar
            android:id="@+id/pendingProgress"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pendingProgressLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="#666666"
            android:textSize="11sp"
            android:visibility="gone" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/pendingAttachmentsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Input footer -->
    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/btnAttach"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Đính kèm file"
            android:padding="8dp"
            android:src="@drawable/ic_attach_file"
            app:tint="#555555" />

        <EditText
            android:id="@+id/etInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#F0F0F2"
            android:hint="Hỏi AI..."
            android:imeOptions="actionSend"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:minHeight="40dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="64dp"
            android:text="Gửi" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
