<?xml version="1.0" encoding="utf-8"?>
<!--
  item_calendar_day.xml
  Structure: tvDayName · flDayCircle (tvDayNumber) · tvTaskCount
  Selected = bg_selected_day (đỏ HUST filled) · Today = bg_today_day (đỏ outline)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="2dp"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/tvDayName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:text="Mon"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <FrameLayout
        android:id="@+id/flDayCircle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/tvDayNumber"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="15"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Task badge — INVISIBLE (not GONE) để giữ ổn định chiều cao -->
    <TextView
        android:id="@+id/tvTaskCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:fontFamily="sans-serif-medium"
        android:text="3"
        android:textColor="@color/hust_red"
        android:textSize="10sp"
        android:visibility="invisible" />
</LinearLayout>
