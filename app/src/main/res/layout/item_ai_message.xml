<?xml version="1.0" encoding="utf-8"?>
<!--
  item_ai_message.xml — bubble tin nhắn AI chat.

  AiMessageAdapter ẩn/hiện 1 trong 2 LinearLayout (bubbleUser hoặc bubbleAssistant)
  tuỳ role. Dùng FrameLayout root để 2 bubble overlap nhưng align trái/phải khác nhau.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="12dp"
    android:paddingVertical="4dp">

    <!-- USER bubble: align right, primary color -->
    <LinearLayout
        android:id="@+id/bubbleUser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:background="#0DC7D0"
        android:maxWidth="280dp"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- ASSISTANT bubble: align left, surface color -->
    <LinearLayout
        android:id="@+id/bubbleAssistant"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:background="@android:color/white"
        android:maxWidth="280dp"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvAssistant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#222222"
            android:textIsSelectable="true"
            android:textSize="14sp" />
    </LinearLayout>

</FrameLayout>
