<?xml version="1.0" encoding="utf-8"?>
<!--
  task_layout.xml — Card hiển thị 1 công việc trong danh sách.
  Thiết kế mới: left accent bar màu HUST red, card trắng sạch với shadow nhẹ.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="0dp"
    android:layout_marginVertical="4dp"
    android:background="@android:color/white"
    android:elevation="1dp"
    android:orientation="horizontal">

    <!-- Left accent bar — màu theo priority (set từ adapter) -->
    <View
        android:id="@+id/viewPriorityAccent"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@color/hust_red" />

    <!-- Checkbox -->
    <CheckBox
        android:id="@+id/checkbox"
        android:layout_width="52dp"
        android:layout_height="match_parent"
        android:layout_gravity="center_vertical"
        android:gravity="center"
        android:buttonTint="@color/hust_red" />

    <!-- Content: time + title + description + tags -->
    <LinearLayout
        android:id="@+id/linearTextGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginVertical="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start - End"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Tiêu đề công việc"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:text="Mô tả"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tagsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Delete button -->
    <ImageView
        android:id="@+id/delete_button"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center_vertical"
        android:contentDescription="Xoá"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_deletetask"
        app:tint="@color/hust_red" />

</LinearLayout>
