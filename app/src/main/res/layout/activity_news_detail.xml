<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_news_detail.xml — chi tiết 1 news.

  ┌──────────────────────────────────┐
  │ ← Chi tiết                        │ Header
  ├──────────────────────────────────┤
  │ [Tin tức] [CTSV] · 07/05/2026     │ contentGroup
  │ TIÊU ĐỀ LỚN                       │
  │                                   │
  │ Nội dung full body                │
  │                                   │
  │ ── Tệp đính kèm ──                │ ← MỚI (visibility theo data)
  │ [📎 proposal.pdf  · 1.2 MB]       │
  │ [📎 budget.xlsx   · 230 KB]       │
  │                                   │
  │ [Mở trên trang gốc]               │
  └──────────────────────────────────┘
        FAB "Chat với AI" góc phải dưới
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F8">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingVertical="32dp">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@android:drawable/ic_menu_revert" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="Chi tiết"
                android:textColor="#222222"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Content scrollable -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header">

            <LinearLayout
                android:id="@+id/contentGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="96dp">

                <!-- Row meta: kind + tag + date -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvKind"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_news_kind_chip_news"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="Tin tức" />

                    <TextView
                        android:id="@+id/tvTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="#1976D2"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="CTSV" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:id="@+id/tvDate"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        tools:text="07/05/2026" />
                </LinearLayout>

                <!-- Title -->
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingExtra="4dp"
                    android:textColor="#222222"
                    android:textSize="18sp"
                    tools:text="KẾT QUẢ XÉT CẤP HỌC BỔNG KHUYẾN KHÍCH HỌC TẬP KỲ II NĂM HỌC 2025-2026" />

                <!-- Summary -->
                <TextView
                    android:id="@+id/tvSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    tools:text="Nội dung chi tiết của bài viết..." />

                <!-- ═══ MỚI: Section attachments ═══ -->
                <TextView
                    android:id="@+id/tvAttachmentsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp"
                    android:drawableStart="@drawable/ic_attach_file"
                    android:drawablePadding="6dp"
                    android:drawableTint="#1976D2"
                    android:fontFamily="sans-serif-medium"
                    android:text="Tệp đính kèm"
                    android:textColor="#1976D2"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAttachments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:visibility="gone"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_attachment"
                    tools:visibility="visible" />

                <!-- Mở trên trang gốc -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenSource"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Mở trên trang gốc HUST CTT"
                    android:textSize="13sp" />
            </LinearLayout>
        </ScrollView>

        <!-- Empty state -->
        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="32dp"
            android:text="Không tìm thấy news.\nVui lòng quay lại danh sách rồi mở lại."
            android:textColor="#999999"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- FAB Chat AI -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAiChat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="Chat với AI"
        app:icon="@android:drawable/ic_menu_send"
        app:iconTint="#FFFFFF"
        android:backgroundTint="#1976D2"
        android:textColor="#FFFFFF" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
