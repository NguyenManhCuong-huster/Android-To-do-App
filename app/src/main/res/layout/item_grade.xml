<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="0dp"
    android:layout_marginVertical="2dp"
    android:background="@android:color/white"
    android:clickable="true"
    android:elevation="1dp"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <!-- Left accent -->
    <View
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="12dp"
        android:background="@color/hust_red" />

    <!-- Course info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCourseCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="IT4785"
            android:textColor="@color/hust_red"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvCourseName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Phát triển ứng dụng cho thiết bị di động"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvCourseNameEn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mobile Programming"
            android:textColor="@color/text_hint"
            android:textSize="11sp"
            android:textStyle="italic" />
    </LinearLayout>

    <!-- Credits -->
    <TextView
        android:id="@+id/tvCredits"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:text="2 TC"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Grade letter -->
    <TextView
        android:id="@+id/tvGrade"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="B"
        android:textColor="@color/hust_red"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Delete button -->
    <ImageButton
        android:id="@+id/btnDeleteGrade"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Xoá học phần"
        android:padding="8dp"
        android:src="@android:drawable/ic_menu_delete"
        app:tint="@color/text_hint"
        xmlns:app="http://schemas.android.com/apk/res-auto" />
</LinearLayout>
