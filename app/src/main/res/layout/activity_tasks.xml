<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/fullscreenBackgroundColor"
    android:padding="32dp"
    android:theme="@style/ThemeOverlay.TodoApp.FullscreenContainer"
    tools:context=".ui.tasks.TasksActivity">

    <!-- 1. Thanh tìm kiếm -->
    <LinearLayout
        android:id="@+id/searchContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/task_border"
        android:padding="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <SearchView
            android:id="@+id/searchView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:iconifiedByDefault="false"
            android:queryHint="Search tasks..."
            android:searchIcon="@null"
            android:background="@null" />
    </LinearLayout>

    <!-- 2. Danh sách lọc Tag (Ngang) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTagFilter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchContainer"
        tools:listitem="@layout/item_tag_filter" />

    <!-- Guideline đẩy xuống dưới vùng search/filter -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideLine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="140dp" /> <!-- Tăng khoảng cách -->

    <!-- Danh sách Task -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rvTagFilter" />


    <!-- Các nút chức năng phía dưới -->
    <ImageView
        android:id="@+id/tagsButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="tag"
        android:layout_marginBottom="16dp"
        android:padding="8dp"
        android:src="@drawable/ic_tag"
        app:tint="@color/light_blue_600"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/syncButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread" />

    <ImageView
        android:id="@+id/syncButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@string/sync_button_desc"
        android:layout_marginBottom="16dp"
        android:padding="8dp"
        android:src="@drawable/ic_sync"
        app:tint="@color/light_blue_600"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/authButton"
        app:layout_constraintStart_toEndOf="@id/tagsButton" />

    <ImageView
        android:id="@+id/authButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@string/acc_button_desc"
        android:layout_marginBottom="16dp"
        android:padding="8dp"
        android:src="@drawable/ic_account"
        app:tint="@color/light_blue_600"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/filterButton"
        app:layout_constraintStart_toEndOf="@id/syncButton" />

    <ImageView
        android:id="@+id/filterButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@string/filter_button_desc"
        android:layout_marginBottom="16dp"
        android:padding="4dp"
        android:src="@drawable/ic_filter"
        app:tint="@color/light_blue_600"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/addTaskButton"
        app:layout_constraintStart_toEndOf="@id/authButton" />

    <ImageView
        android:id="@+id/addTaskButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@string/add_task_button_desc"
        android:layout_marginBottom="16dp"
        android:padding="8dp"
        android:src="@drawable/ic_add"
        app:tint="@color/light_blue_600"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/filterButton" />

</androidx.constraintlayout.widget.ConstraintLayout>