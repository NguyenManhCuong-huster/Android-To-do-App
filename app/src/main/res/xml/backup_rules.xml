<?xml version="1.0" encoding="utf-8"?>
<!--
  backup_rules.xml — Android auto-backup config (pre-Android 12).
  Loại trừ token + cache để không backup credential lên Drive.
-->
<full-backup-content>
    <!-- Loại trừ SharedPreferences chứa JWT / OAuth tokens. -->
    <exclude
        domain="sharedpref"
        path="auth_prefs.xml" />
    <exclude
        domain="sharedpref"
        path="server_config_prefs.xml" />

    <!-- Loại trừ cache (chứa file attachment đã tải về). -->
    <exclude
        domain="root"
        path="cache" />
</full-backup-content>
