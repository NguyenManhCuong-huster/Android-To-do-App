<?xml version="1.0" encoding="utf-8"?>
<!--
  data_extraction_rules.xml — Android 12+ (API 31+) data extraction config.
  Áp dụng cho cả cloud-backup (auto-backup) và device-transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="auth_prefs.xml" />
        <exclude domain="sharedpref" path="server_config_prefs.xml" />
        <exclude domain="root" path="cache" />
    </cloud-backup>

    <device-transfer>
        <!-- Cho phép transfer Room database + tags + non-credential prefs. -->
        <exclude domain="sharedpref" path="auth_prefs.xml" />
        <exclude domain="root" path="cache" />
    </device-transfer>
</data-extraction-rules>
